#include <Servo.h> // 또는 스텝모터/DC모터 라이브러리

// 핀 번호 정의
const int PIN_CURRENT_SENSOR = A0; // 과부하(손끼임) 감지용 전류 센서
const int PIN_LIMIT_TOP = 2;       // 상한 리밋 스위치
const int PIN_LIMIT_BOTTOM = 3;    // 하한 리밋 스위치
const int PIN_MOTOR_PWM = 9;       // 모터 속도 제어 (PWM)
const int PIN_MOTOR_DIR = 8;       // 모터 방향 제어

// 제어 임계값 설정
const int CURRENT_THRESHOLD = 500; // 손끼임 감지 전류 기준치 (환경에 맞춰 조절)
const int MAX_HEIGHT_STEP = 100;   // 상한 한계치 (소프트웨어 한계값)
const int MIN_HEIGHT_STEP = 0;     // 하한 한계치 (소프트웨어 한계값)

int current_height = 0;            // 현재 책상 높이 위치
char current_command = 'N';        // 현재 실행 중인 명령

void setup() {
  Serial.begin(9600);
  pinMode(PIN_LIMIT_TOP, INPUT_PULLUP);
  pinMode(PIN_LIMIT_BOTTOM, INPUT_PULLUP);
  pinMode(PIN_MOTOR_PWM, OUTPUT);
  pinMode(PIN_MOTOR_DIR, OUTPUT);
}

void loop() {
  // 1. 라즈베리파이로부터 새로운 신호 수신 (자세 변화 감지)
  if (Serial.available() > 0) {
    char new_command = Serial.read();
    
    // [자세 변화 대응] 구동 중 'N'(정상자세) 신호 들어오면 즉시 멈춤
    if (new_command != current_command) {
      if (new_command == 'N') {
        stopMotorSoft(); // 즉시 부드럽게 정지
      }
      current_command = new_command;
    }
  }

  // 2. 신호에 따른 책상 구동
  if (current_command == 'T' || current_command == 'B') {
    moveDeskUp(); // 거북목/허리굽음 감지 시 높이 올려주기
  }
}

// [급작스러운 동작 방지] Soft Start / Soft Stop 구현
void setMotorSpeed(int targetSpeed) {
  static int currentSpeed = 0;
  
  if (currentSpeed < targetSpeed) {
    for (int speed = currentSpeed; speed <= targetSpeed; speed += 5) {
      analogWrite(PIN_MOTOR_PWM, speed);
      delay(10); // 천천히 가속
    }
  } else {
    for (int speed = currentSpeed; speed >= targetSpeed; speed -= 5) {
      analogWrite(PIN_MOTOR_PWM, speed);
      delay(10); // 천천히 감속
    }
  }
  currentSpeed = targetSpeed;
}

void stopMotorSoft() {
  setMotorSpeed(0); // 부드럽게 멈춤
}

// 책상 상승 구동 함수
void moveDeskUp() {
  // [상/하한 한계치 체크] 스위치 눌림 또는 소프트웨어 한계 도달 시 구동 금지
  if (digitalRead(PIN_LIMIT_TOP) == LOW || current_height >= MAX_HEIGHT_STEP) {
    stopMotorSoft();
    return;
  }

  digitalWrite(PIN_MOTOR_DIR, HIGH); // 정방향 설정
  setMotorSpeed(150); // 부드럽게 가속하며 이동

  // 구동 중 실시간 안전 센서 감지
  while (current_command != 'N' && current_height < MAX_HEIGHT_STEP) {
    // [손끼임 방지] 과부하 감지 시 역동작 및 정지
    if (analogRead(PIN_CURRENT_SENSOR) > CURRENT_THRESHOLD) {
      stopMotorSoft();
      emergencyReverse(); // 안전을 위해 반대 방향으로 살짝 하강
      current_command = 'N'; // 상태 리셋
      break;
    }

    // [자세 변화 실시간 감지] 구동 중 라즈베리파이 신호 수신
    if (Serial.available() > 0) {
      char check_cmd = Serial.read();
      if (check_cmd == 'N') {
        stopMotorSoft(); // 아이가 바른 자세로 돌아오면 즉시 중단
        current_command = 'N';
        break;
      }
    }

    current_height++;
    delay(50);
  }
  
  stopMotorSoft();
}

// [손끼임 발생 시 안전 역동작]
void emergencyReverse() {
  digitalWrite(PIN_MOTOR_DIR, LOW); // 역방향(하강)
  setMotorSpeed(100);
  delay(500); // 0.5초간 살짝 내려서 끼임 해제
  stopMotorSoft();
}
